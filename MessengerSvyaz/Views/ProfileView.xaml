<UserControl x:Class="MessengerSvyaz.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MessengerSvyaz.Converters"
             Background="{StaticResource BgDarkBrush}">

    <UserControl.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:InverseStringToVisibilityConverter x:Key="InverseStringToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Button Content="← Назад" Command="{Binding GoBackCommand}" 
                Background="Transparent" Foreground="{StaticResource AccentBlueBrush}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"/>

        <Border Width="450" Background="{StaticResource BgMediumBrush}" CornerRadius="10" 
                Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Профиль" FontSize="24" FontWeight="Bold" 
                           Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Grid Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <Border Background="{StaticResource BgLightBrush}" CornerRadius="50">
                        <TextBlock Text="{Binding Username[0]}" FontSize="48" FontWeight="Bold"
                                   Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding AvatarUrl, Converter={StaticResource InverseStringToVisibilityConverter}}"/>
                    </Border>
                    <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" 
                           Visibility="{Binding AvatarUrl, Converter={StaticResource StringToVisibilityConverter}}">
                        <Image.Clip>
                            <EllipseGeometry RadiusX="50" RadiusY="50" Center="50,50"/>
                        </Image.Clip>
                    </Image>
                </Grid>

                <Button Content="Изменить аватар" Command="{Binding UploadAvatarCommand}" 
                        Background="{StaticResource BgLightBrush}" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding Username}" FontSize="20" FontWeight="SemiBold" 
                           Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                <TextBlock Text="О себе" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}" 
                         Background="{StaticResource BgLightBrush}" Padding="10" Margin="0,0,0,10"/>
                <Button Content="Сохранить" Command="{Binding SaveBioCommand}" 
                        Background="{StaticResource AccentGreenBrush}" Foreground="White" Margin="0,0,0,20"/>

                <TextBlock Text="Сменить пароль" FontSize="16" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="Текущий пароль" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="CurrentPasswordBox" Background="{StaticResource BgLightBrush}" Padding="10" Margin="0,0,0,10"/>

                <TextBlock Text="Новый пароль" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="NewPasswordBox" Background="{StaticResource BgLightBrush}" Padding="10" Margin="0,0,0,10"/>

                <TextBlock Text="Подтвердите пароль" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Background="{StaticResource BgLightBrush}" Padding="10" Margin="0,0,0,15"/>

                <Button Content="Изменить пароль" Command="{Binding ChangePasswordCommand}" 
                        Background="{StaticResource AccentBlueBrush}" Foreground="White" Padding="12"/>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentGreenBrush}" 
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,15,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>