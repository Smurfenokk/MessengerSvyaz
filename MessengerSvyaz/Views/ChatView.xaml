<UserControl x:Class="MessengerSvyaz.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MessengerSvyaz.Converters"
             Background="{StaticResource BgDarkBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:MessageAlignmentConverter x:Key="MessageAlignmentConverter"/>
        <converters:MessageBackgroundConverter x:Key="MessageBackgroundConverter"/>
        <converters:TimestampToTimeConverter x:Key="TimestampToTimeConverter"/>
        <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
        <converters:MessageStatusToIconConverter x:Key="MessageStatusToIconConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgMediumBrush}" Padding="15" Margin="10,10,10,0" CornerRadius="10,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Назад" Command="{Binding GoBackCommand}" 
                        Background="Transparent" Foreground="{StaticResource AccentBlueBrush}"/>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding OtherUser}" FontSize="18" FontWeight="Bold" 
                               Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding OtherUserOnline, Converter={StaticResource BoolToStringConverter}, ConverterParameter=В сети;Не в сети}" 
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                               Visibility="{Binding IsOtherUserTyping, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBlock Text="печатает..." FontSize="12" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Center"
                               Visibility="{Binding IsOtherUserTyping, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <Button Grid.Column="2" Content="↻" Command="{Binding RefreshCommand}" 
                        Background="{StaticResource BgLightBrush}" Width="35" Height="35"/>
            </Grid>
        </Border>

        <ListBox Grid.Row="1" ItemsSource="{Binding Messages}"
                 Background="{StaticResource BgMediumBrush}" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.ScrollChanged="Messages_ScrollChanged"
                 SelectionMode="Single">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border HorizontalAlignment="{Binding Sender, Converter={StaticResource MessageAlignmentConverter}, ConverterParameter={Binding DataContext.CurrentUser, RelativeSource={RelativeSource AncestorType=UserControl}}}"
                            Background="{Binding Sender, Converter={StaticResource MessageBackgroundConverter}, ConverterParameter={Binding DataContext.CurrentUser, RelativeSource={RelativeSource AncestorType=UserControl}}}"
                            CornerRadius="10" Padding="12" Margin="10,5" MaxWidth="400">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Редактировать" Command="{Binding DataContext.EditMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <MenuItem Header="Удалить" Command="{Binding DataContext.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                            <Image Source="{Binding FileUrl}" MaxHeight="200" Margin="0,0,0,5"
                                   Visibility="{Binding FileType, Converter={StaticResource StringToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" 
                                       Foreground="{StaticResource TextLightBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                <TextBlock Text="(ред.)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,5,0"
                                           Visibility="{Binding Edited, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding Timestamp, Converter={StaticResource TimestampToTimeConverter}}" 
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Status, Converter={StaticResource MessageStatusToIconConverter}}" 
                                           FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                           Visibility="{Binding IsSentByCurrentUser, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Background="{StaticResource BgMediumBrush}" Padding="15" Margin="10,0,10,10" CornerRadius="0,0,10,10">
            <StackPanel>
                <Border Background="{StaticResource BgLightBrush}" CornerRadius="5" Padding="10" Margin="0,0,0,10"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Редактирование..." Foreground="{StaticResource TextMutedBrush}" 
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CancelEditCommand}" 
                                Background="Transparent" Foreground="{StaticResource AccentRedBrush}" Padding="5"/>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="📎" Command="{Binding SendFileCommand}" 
                            Background="{StaticResource BgLightBrush}" Width="40" Margin="0,0,10,0"/>

                    <TextBox Grid.Column="1" x:Name="MessageTextBox" Text="{Binding NewMessage, UpdateSourceTrigger=PropertyChanged}" 
                             Background="{StaticResource BgLightBrush}" Padding="12"
                             Foreground="{StaticResource TextLightBrush}" KeyDown="MessageBox_KeyDown"/>

                    <Button Grid.Column="2" Content="Отправить" Command="{Binding SendCommand}" 
                            Background="{StaticResource AccentBlueBrush}" Foreground="White" Padding="15,12" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>