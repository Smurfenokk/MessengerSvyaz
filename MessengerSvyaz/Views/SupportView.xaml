<UserControl x:Class="MessengerSvyaz.Views.SupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MessengerSvyaz.Converters"
             Background="{StaticResource BgDarkBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:SupportTypeToAlignmentConverter x:Key="SupportTypeToAlignmentConverter"/>
        <converters:SupportTypeToBrushConverter x:Key="SupportTypeToBrushConverter"/>
        <converters:TimestampToTimeConverter x:Key="TimestampToTimeConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgMediumBrush}" Padding="15" Margin="10,10,10,0" CornerRadius="10,10,0,0">
            <Grid>
                <Button Content="← Назад" Command="{Binding GoBackCommand}" 
                        Background="Transparent" Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Left"/>

                <TextBlock Text="Поддержка" FontSize="18" FontWeight="Bold" 
                           Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Center"/>

                <Button Content="↻" Command="{Binding RefreshCommand}" 
                        Background="{StaticResource BgLightBrush}" Width="35" Height="35" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource BgMediumBrush}" Margin="10,0" Padding="15">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="{Binding Type, Converter={StaticResource SupportTypeToAlignmentConverter}}"
                                    Background="{Binding Type, Converter={StaticResource SupportTypeToBrushConverter}}"
                                    CornerRadius="10" Padding="12" Margin="0,0,0,8" MaxWidth="400">
                                <StackPanel>
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" 
                                               Foreground="{StaticResource TextLightBrush}"/>
                                    <TextBlock Text="{Binding Timestamp, Converter={StaticResource TimestampToTimeConverter}}" 
                                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                               HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource BgMediumBrush}" Padding="15" Margin="10,0,10,10" CornerRadius="0,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding NewMessage, UpdateSourceTrigger=PropertyChanged}" 
                         Background="{StaticResource BgLightBrush}" Padding="12" Margin="0,0,10,0"
                         Foreground="{StaticResource TextLightBrush}"/>

                <Button Grid.Column="1" Content="Отправить" Command="{Binding SendCommand}" 
                        Background="{StaticResource AccentGreenBrush}" Foreground="White" Padding="15,12"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>