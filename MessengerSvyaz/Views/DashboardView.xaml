<UserControl x:Class="MessengerSvyaz.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MessengerSvyaz.Converters"
             Background="{StaticResource BgDarkBrush}">

    <UserControl.Resources>
        <converters:OnlineStatusConverter x:Key="OnlineStatusConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BgMediumBrush}" Margin="10" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="15,15,15,10">
                    <TextBlock Text="{Binding CurrentUsername}" FontSize="18" FontWeight="Bold" 
                               Foreground="{StaticResource TextLightBrush}"/>
                    <TextBlock Text="Онлайн" FontSize="12" Foreground="{StaticResource AccentGreenBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="15,0,15,10">
                    <Button Command="{Binding NavigateProfileCommand}" 
                            Background="{StaticResource BgLightBrush}" Margin="0,0,0,5" Padding="10">
                        <TextBlock Text="Профиль" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding NavigateGroupsCommand}" 
                            Background="{StaticResource BgLightBrush}" Margin="0,0,0,5" Padding="10">
                        <TextBlock Text="Группы" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding NavigateSupportCommand}" 
                            Background="{StaticResource BgLightBrush}" Margin="0,0,0,5" Padding="10">
                        <TextBlock Text="Поддержка" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding OpenSavedCommand}" 
                            Background="{StaticResource AccentBlueBrush}" Foreground="White" Margin="0,0,0,5" Padding="10">
                        <TextBlock Text="Избранное" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding LogoutCommand}" 
                            Background="{StaticResource AccentRedBrush}" Foreground="White" Padding="10">
                        <TextBlock Text="Выйти" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="2" Margin="15,0">
                    <StackPanel>
                        <TextBlock Text="Недавние чаты" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                        
                        <ItemsControl ItemsSource="{Binding RecentChats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgLightBrush}" CornerRadius="5" 
                                            Margin="0,0,0,5" Padding="10" Cursor="Hand"
                                            Tag="{Binding}" MouseLeftButtonDown="ChatItem_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold" 
                                                           Foreground="{StaticResource TextLightBrush}"/>
                                                <TextBlock Text="{Binding LastMessage}" FontSize="11" 
                                                           Foreground="{StaticResource TextMutedBrush}" 
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{StaticResource AccentBlueBrush}" 
                                                    CornerRadius="10" Padding="5,2" 
                                                    Visibility="{Binding UnreadCount, Converter={StaticResource CountToVisibilityConverter}}">
                                                <TextBlock Text="{Binding UnreadCount}" FontSize="10" 
                                                           Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="3" Command="{Binding RefreshCommand}" 
                        Background="{StaticResource BgLightBrush}" Margin="15" Padding="10">
                    <TextBlock Text="Обновить" HorizontalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource BgMediumBrush}" Margin="0,10,10,10" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgLightBrush}" CornerRadius="10,10,0,0" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="{StaticResource BgMediumBrush}"
                                 Foreground="{StaticResource TextLightBrush}"
                                 Padding="10" 
                                 KeyDown="SearchBox_KeyDown"/>
                        <Button Grid.Column="1" Command="{Binding SearchCommand}" 
                                Background="{StaticResource AccentBlueBrush}" Foreground="White" 
                                Padding="15,0" Margin="10,0,0,0">
                            <TextBlock Text="Поиск"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="15">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Users}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgLightBrush}" CornerRadius="5" 
                                            Margin="0,0,0,5" Padding="10" Cursor="Hand"
                                            Tag="{Binding}" MouseLeftButtonDown="UserItem_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Ellipse Grid.Column="0" Width="40" Height="40" Fill="{StaticResource BgMediumBrush}" Margin="0,0,10,0"/>
                                            
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold" 
                                                           Foreground="{StaticResource TextLightBrush}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,5,0"
                                                             Fill="{Binding IsOnline, Converter={StaticResource OnlineStatusConverter}}"/>
                                                    <TextBlock Text="{Binding IsOnline, Converter={StaticResource BoolToStringConverter}, ConverterParameter=Онлайн;Офлайн}" 
                                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <TextBlock Text="Введите имя пользователя в поиске и нажмите Enter" 
                                   Foreground="{StaticResource TextMutedBrush}" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Users.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>