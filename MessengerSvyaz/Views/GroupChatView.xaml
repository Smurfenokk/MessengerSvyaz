<UserControl x:Class="MessengerSvyaz.Views.GroupChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MessengerSvyaz.Converters"
             Background="{StaticResource BgDarkBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:TimestampToTimeConverter x:Key="TimestampToTimeConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgMediumBrush}" Margin="10,10,10,0" CornerRadius="10,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Назад" Command="{Binding GoBackCommand}" 
                        Background="Transparent" Foreground="{StaticResource AccentBlueBrush}" Padding="15"/>

                <Border Grid.Column="1" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Header_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                        <TextBlock Text="{Binding GroupName}" FontSize="18" FontWeight="Bold" 
                                   Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Групповой чат" FontSize="12" Foreground="{StaticResource TextMutedBrush}" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="2" Content="↻" Command="{Binding RefreshCommand}" 
                        Background="{StaticResource BgLightBrush}" Width="35" Height="35" Margin="10"/>
            </Grid>
        </Border>

        <ListBox Grid.Row="1" ItemsSource="{Binding Messages}"
                 Background="{StaticResource BgMediumBrush}" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.ScrollChanged="Messages_ScrollChanged"
                 SelectionMode="Single">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource BgLightBrush}" CornerRadius="10" 
                            Padding="12" Margin="10,5" HorizontalAlignment="Left" MaxWidth="400">
                        <StackPanel>
                            <TextBlock Text="{Binding Sender}" FontWeight="Bold" FontSize="12" 
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" 
                                       Foreground="{StaticResource TextLightBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding Timestamp, Converter={StaticResource TimestampToTimeConverter}}" 
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Reactions}" Margin="0,5,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgDarkBrush}" CornerRadius="10" 
                                                Padding="5,2" Margin="0,0,5,0" Cursor="Hand"
                                                MouseLeftButtonDown="Reaction_Click">
                                            <TextBlock FontSize="12">
                                                <Run Text="{Binding Key}"/>
                                                <Run Text="{Binding Value.Count}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0" 
                                        Visibility="{Binding DataContext.AllowReactions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Content="👍" Command="{Binding DataContext.AddReactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding Id}" Tag="👍" Click="ReactionButton_Click" Margin="0,0,5,0"/>
                                <Button Content="❤️" Command="{Binding DataContext.AddReactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding Id}" Tag="❤️" Click="ReactionButton_Click" Margin="0,0,5,0"/>
                                <Button Content="😂" Command="{Binding DataContext.AddReactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding Id}" Tag="😂" Click="ReactionButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Background="{StaticResource BgMediumBrush}" Padding="15" Margin="10,0,10,10" CornerRadius="0,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" x:Name="MessageTextBox" Text="{Binding NewMessage, UpdateSourceTrigger=PropertyChanged}" 
                         Background="{StaticResource BgLightBrush}" Padding="12" Margin="0,0,10,0"
                         Foreground="{StaticResource TextLightBrush}" KeyDown="MessageBox_KeyDown"/>

                <Button Grid.Column="1" Content="Отправить" Command="{Binding SendCommand}" 
                        Background="{StaticResource AccentBlueBrush}" Foreground="White" Padding="15,12"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>