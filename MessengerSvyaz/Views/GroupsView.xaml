<UserControl x:Class="MessengerSvyaz.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MessengerSvyaz.Converters"
             Background="{StaticResource BgDarkBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:RoleToStringConverter x:Key="RoleToStringConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BgMediumBrush}" Margin="10" CornerRadius="10">
            <ScrollViewer>
                <StackPanel Margin="15">
                    <Button Content="← Назад" Command="{Binding GoBackCommand}" 
                            Background="Transparent" Foreground="{StaticResource AccentBlueBrush}" 
                            HorizontalAlignment="Left" Margin="0,0,0,15"/>

                    <TextBlock Text="Мои группы" FontSize="18" FontWeight="Bold" 
                               Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,15"/>

                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgLightBrush}" CornerRadius="5" 
                                        Margin="0,0,0,8" Padding="12" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource TextLightBrush}"/>
                                            <TextBlock Text="{Binding Role, Converter={StaticResource RoleToStringConverter}}" 
                                                       FontSize="10" Margin="8,0,0,0" Foreground="{StaticResource AccentYellowBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding MembersCount, StringFormat='{}{0} участников'}" 
                                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource BgMediumBrush}" Margin="0,10,10,10" CornerRadius="10">
            <ScrollViewer>
                <StackPanel Margin="20">
                    <TextBlock Text="Создать группу" FontSize="18" FontWeight="Bold" 
                               Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,15"/>

                    <TextBlock Text="Название" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" 
                             Background="{StaticResource BgLightBrush}" Padding="10" Margin="0,0,0,10"/>

                    <TextBlock Text="Описание" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewGroupDescription, UpdateSourceTrigger=PropertyChanged}" 
                             Background="{StaticResource BgLightBrush}" Padding="10" Margin="0,0,0,10"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

                    <CheckBox IsChecked="{Binding AllowReactions}" Content="Разрешить реакции" 
                              Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,15"/>

                    <Button Content="Создать" Command="{Binding CreateGroupCommand}" 
                            Background="{StaticResource AccentGreenBrush}" Foreground="White" 
                            Padding="12" FontWeight="SemiBold" Margin="0,0,0,30"/>

                    <TextBlock Text="Присоединиться к группе" FontSize="18" FontWeight="Bold" 
                               Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,15"/>

                    <TextBlock Text="ID группы" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding JoinGroupId, UpdateSourceTrigger=PropertyChanged}" 
                             Background="{StaticResource BgLightBrush}" Padding="10" Margin="0,0,0,15"/>

                    <Button Content="Присоединиться" Command="{Binding JoinGroupCommand}" 
                            Background="{StaticResource AccentBlueBrush}" Foreground="White" 
                            Padding="12" FontWeight="SemiBold"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>